# Tier-1 test: barge-in OFF so the recognizer listens ONLY after the agent
# finishes speaking — prevents the agent's own speaker echo from triggering empty
# "Heard=no" captures. Set back to 1 to re-enable interrupting.
BARGE_IN=0

# Lower trailing-silence endpoint for lower latency (was 3s). 1s would clip
# callers who pause mid-thought; 2s is the safer low-latency choice.
SPEECH_TIMEOUT=2

# Relaxed for strict-English input (0.3 over-rejected short clean words; echo is
# already cut by BARGE_IN=0). Set 0 to disable the gate entirely.
CONFIDENCE_MIN=0.15

# ── LangSmith Tracing ─────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<your-api-key>"
LANGSMITH_PROJECT="calling agent"
