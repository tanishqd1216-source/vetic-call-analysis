# ── LiveKit Cloud (create a project at https://cloud.livekit.io) ──────────────
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Sarvam — does BOTH STT and TTS (you already have this key) ────────────────
SARVAM_API_KEY=xxxxxxxxxxxxxxxx

# ── LLM: OpenAI gpt-4o-mini (hardcoded model, no LLM_MODEL override) ──────────
OPENAI_API_KEY=sk-xxxxxxxx

# Optional: route LLM calls through a local Headroom proxy (`headroom proxy --port 8787`)
# to compress the outgoing prompt before it hits OpenAI. Falls back to calling OpenAI
# directly if unset or the proxy isn't running.
HEADROOM_PROXY_URL=http://127.0.0.1:8787/v1

# ── Agent config (all optional — these are the defaults) ──────────────────────
TEST_CALL_IDENTIFIER=352027
TICKET_DB_PATH=C:\Users\hp\Desktop\sample data\sample_ticket_summary.xlsx

# ── Live customer lookup (vetic_live_db.py) — optional ────────────────────────
# Read-only connection string for the user_profile Mongo cluster. If unset, the
# agent falls back to the static TICKET_DB_PATH lookup above.
VETIC_MONGO_URI=mongodb://readonly-user:xxxxxxxx@host:27017/user_profile
VETIC_MONGO_DB=user_profile
VETIC_MONGO_COLLECTION=user_profile

# Sarvam STT (saaras v3 transcribe mode)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN

# Sarvam TTS (keeps the "Aarya" voice: priya / bulbul:v3)
SARVAM_TARGET_LANG=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
SARVAM_SAMPLE_RATE=22050

# ── ai-call-agent dashboard backend (event_reporter.py) — optional ────────────
# Best-effort call-event reporting; a missing/unreachable backend never
# breaks a call. Defaults to a local backend on the same machine.
EVENTS_API_URL=http://localhost:4000/api/events

# ── LangSmith Tracing (setup_langsmith() in agent_inbound.py / agent_outbound.py) — optional ──
# Requires the `langsmith[livekit]` extra (see requirements.txt). If unset or the
# package isn't installed, tracing is silently skipped and the call still runs.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=vetic-calling-agent
